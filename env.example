# رابط قاعدة بيانات PostgreSQL (من Render أو أي مزوّد)
DATABASE_URL=postgres://user:password@host:5432/dbname

# سر عشوائي طويل لتوقيع الجلسات — ولّده بنفسك، لا تستخدم قيمة معروفة
# مثال لتوليد واحد محليًا: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

